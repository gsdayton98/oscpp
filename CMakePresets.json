{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Common settings. Builds go outside the source tree, in ../build/oscpp/<preset>.",
      "binaryDir": "${sourceDir}/../build/oscpp/${presetName}",
      "cacheVariables": {
        "OSCPP_WERROR": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "Debug with AddressSanitizer and UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OSCPP_SANITIZE": "address;undefined"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "ThreadSanitizer",
      "description": "Run the stress tests with the tsan-stress test preset.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "OSCPP_SANITIZE": "thread"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true }
    },
    { "name": "debug", "inherits": "base", "configurePreset": "debug" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan" },
    { "name": "tsan", "inherits": "base", "configurePreset": "tsan" },
    {
      "name": "debug-unit",
      "inherits": "base",
      "configurePreset": "debug",
      "displayName": "Unit tests only (skips the stress tests)",
      "filter": { "exclude": { "label": "stress" } }
    },
    {
      "name": "tsan-stress",
      "inherits": "base",
      "configurePreset": "tsan",
      "displayName": "Stress tests under ThreadSanitizer",
      "filter": { "include": { "label": "stress" } }
    }
  ]
}
